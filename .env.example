# --- AI model ---
# ollama = free, self-hosted open model (default). claude = paid hosted API.
LLM_PROVIDER=ollama

# Ollama (self-hosted). Pick a model that fits your VPS's RAM; see README.
OLLAMA_MODEL=qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434
# Reasoning mode: smarter but much slower. Leave off on a CPU-only VPS.
# OLLAMA_THINK=false
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=180000

# Claude (only if LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# --- Bot ---
BOT_NAME=Assistant
# IANA time zone used to read and send reminder times
TIMEZONE=Asia/Karachi
# Extra words that address the bot in groups (besides @mentions, replies, and BOT_NAME)
# GROUP_TRIGGERS=bot,hey bot
# Only these numbers may DM the bot (digits, comma-separated). Empty = anyone. Groups always work.
# ALLOWED_NUMBERS=923001234567
# DATA_DIR=./data
# HISTORY_TURNS=20

# --- WhatsApp transport: baileys (linked device, supports groups) or cloud (official Meta API, DMs only) ---
WA_TRANSPORT=baileys

# baileys: leave empty to log in with a QR code, or set the bot's number to get a pairing code instead
# WA_PAIRING_NUMBER=923001234567
# BAILEYS_AUTH_DIR=./data/baileys-auth

# cloud (Meta WhatsApp Business Cloud API)
# PORT=3000
# WA_VERIFY_TOKEN=pick-any-random-string
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_APP_SECRET=
# WA_GRAPH_VERSION=v23.0
# Approved template with one body variable {{1}}, used for reminders sent >24h after the user's last message
# WA_REMINDER_TEMPLATE=reminder
# WA_REMINDER_TEMPLATE_LANG=en
