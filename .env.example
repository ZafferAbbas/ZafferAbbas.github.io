# --- AI model ---
# claude = Claude API (reads photos and PDFs). ollama = free self-hosted model (text only).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Ollama (only if LLM_PROVIDER=ollama; start with: docker compose --profile ollama up -d)
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_THINK=false
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=180000

# --- Bot ---
BOT_NAME=Assistant
# Language the bot always replies in, e.g. "Roman Urdu" or "English".
# Empty = the person's own language, and Roman Urdu for anyone using Urdu (in any script).
# REPLY_LANGUAGE=
# IANA time zone used to read and send reminder times
TIMEZONE=Asia/Karachi
# Only these numbers may message the bot (digits, comma-separated). Empty = anyone.
# Staff and managers below are always allowed.
# ALLOWED_NUMBERS=923001234567
# DATA_DIR=./data
# HISTORY_TURNS=20

# --- Purchase orders ---
# Managers approve purchase orders. Purchase orders are off until at least one is set.
MANAGER_NUMBERS=923009999999
# Staff who may create purchase orders. Empty = anyone allowed to use the bot.
STAFF_NUMBERS=923001111111,923002222222
COMPANY_NAME=Your Company Ltd
CURRENCY=PKR
# PO_PREFIX=PO-
# Let a manager approve their own purchase orders (default: another manager must)
# PO_ALLOW_SELF_APPROVAL=false

# --- Odoo (approved purchase orders are created in Odoo; products and vendors are looked up there) ---
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
# API key of the bot's Odoo user: Preferences > Account Security > New API Key. The user needs Purchase rights.
ODOO_API_KEY=
# json2 for Odoo 19 and later; jsonrpc for Odoo 18 and earlier (then also set ODOO_LOGIN)
ODOO_API=json2
# ODOO_LOGIN=bot@yourcompany.com
# Confirm the order in Odoo once approved on WhatsApp (true), or leave it as an RFQ (false)
ODOO_CONFIRM=true

# --- Custom ERP (optional): approved purchase orders are POSTed here as signed JSON; see README ---
# CUSTOM_ERP_URL=https://erp.yourcompany.com/api/whatsapp-purchase-orders
# CUSTOM_ERP_SECRET=a-long-random-string

# --- Voice notes (off by default) ---
# Claude can't listen to audio, so voice notes need a Whisper speech-to-text server (~3 GB more RAM).
# To turn them on: set STT_URL=http://stt:8000 and start with: docker compose --profile voice up -d
# Without it, the bot asks people to type or send a photo instead.
# STT_URL=http://stt:8000
# Default: large-v3-turbo, much better at Urdu and Farsi than the small models (needs ~2-3 GB RAM).
# STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Force one language, e.g. ur. Empty = detect automatically (Urdu, Farsi, Sindhi, English, ...).
# STT_LANGUAGE=
# When Whisper hears Hindi, transcribe again as Urdu (spoken Urdu is often detected as Hindi). "none" turns it off.
# STT_LANGUAGE_REMAP=hi:ur

# --- WhatsApp: official Cloud API (default) ---
WA_TRANSPORT=cloud
# Domain pointing at your VPS; Caddy (docker-compose) gets HTTPS for it. Webhook URL: https://DOMAIN/webhook
DOMAIN=bot.example.com
# Any random string; enter the same one in Meta's webhook settings
WA_VERIFY_TOKEN=change-me-to-a-random-string
# From Meta: System User permanent token, phone number ID, and App Secret (App settings > Basic)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# WA_GRAPH_VERSION=v23.0

# Approved templates, used when someone hasn't messaged the bot in the last 24 hours (see README).
# Language code of the templates:
WA_TEMPLATE_LANG=en
# Utility template, body "Reminder: {{1}}"
WA_REMINDER_TEMPLATE=reminder
# Utility template, body "Purchase order update: {{1}}"
WA_UPDATE_TEMPLATE=po_update
# Utility template, body "Approval needed: {{1}}", with two quick-reply buttons: Approve, Reject
WA_APPROVAL_TEMPLATE=po_approval
# PORT=3000

# --- Alternative: unofficial linked-device mode (supports groups, but the number can be banned) ---
# WA_TRANSPORT=baileys
# WA_PAIRING_NUMBER=923001234567
# BAILEYS_AUTH_DIR=./data/baileys-auth
