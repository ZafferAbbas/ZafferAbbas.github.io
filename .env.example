# --- AI model ---
# ollama = free, self-hosted open model (default). claude = paid hosted API.
LLM_PROVIDER=ollama

# Ollama (self-hosted). Pick a model that fits your VPS's RAM; see README.
OLLAMA_MODEL=qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434
# Reasoning mode: smarter but much slower. Leave off on a CPU-only VPS.
# OLLAMA_THINK=false
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=180000

# Claude (only if LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# --- Bot ---
BOT_NAME=Assistant
# IANA time zone used to read and send reminder times
TIMEZONE=Asia/Karachi
# Only these numbers may message the bot (digits, comma-separated). Empty = anyone.
# ALLOWED_NUMBERS=923001234567
# DATA_DIR=./data
# HISTORY_TURNS=20

# --- WhatsApp: official Cloud API (default) ---
WA_TRANSPORT=cloud
# Domain pointing at your VPS; Caddy (docker-compose) gets HTTPS for it. Webhook URL: https://DOMAIN/webhook
DOMAIN=bot.example.com
# Any random string; enter the same one in Meta's webhook settings
WA_VERIFY_TOKEN=change-me-to-a-random-string
# From Meta: System User permanent token, phone number ID, and App Secret (App settings > Basic)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# WA_GRAPH_VERSION=v23.0
# Approved utility template with one body variable {{1}}. Needed for reminders due more than 24h after
# the person's last message; without it those reminders can't be delivered.
WA_REMINDER_TEMPLATE=reminder
WA_REMINDER_TEMPLATE_LANG=en
# PORT=3000

# --- Alternative: unofficial linked-device mode (supports groups, but the number can be banned) ---
# WA_TRANSPORT=baileys
# WA_PAIRING_NUMBER=923001234567
# BAILEYS_AUTH_DIR=./data/baileys-auth
